OPENAI_API_KEY=sk-your-model-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# Use a real DeepSeek chat model.
AIRLINE_AGENT_MODEL=deepseek-v4-flash

# Optional: if omitted, the guardrails use AIRLINE_AGENT_MODEL.
AIRLINE_GUARDRAIL_MODEL=deepseek-v4-flash

# Keep OpenAI platform tracing off when you are not using a platform.openai.com API key.
OPENAI_TRACING_DISABLED=1

# Optional: enable Langfuse tracing for session-based bad case review.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: helps split traces by environment via Langfuse tags/metadata.
APP_ENV=development

# Comma-separated frontend origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:3000,https://ui-three-red.vercel.app

# Optional: when set, the backend reads scheduling data from Supabase.
# Keep SUPABASE_SERVICE_ROLE_KEY server-side only. Never expose it in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: demo write protection for schedule mutations.
# Frontend requests must send this value in X-Shift-Write-Token.
SHIFT_WRITE_TOKEN=change-me-before-demo

# Optional: require a Supabase logged-in user with store write permission for writes.
# Keep off for quick demos; turn on before inviting other users.
REQUIRE_SUPABASE_AUTH_FOR_WRITES=0
